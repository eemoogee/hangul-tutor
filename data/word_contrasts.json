  {
    "id": "wc-grammar-deo-do-001",
    "confusion": {
      "type": "grammar",
      "left_jamo": "더",
      "right_jamo": "도",
      "display_label": "더 / 도"
    },
    "contrast_type": "lexical_vs_grammar_form",
    "stage": 3,
    "items": [
      {
        "form": "더",
        "romanization": "deo",
        "meaning_en": "more",
        "part_of_speech": "adverb",
        "requires_host": true,
        "example_ko": "더 주세요.",
        "example_en": "Please give me more."
      },
      {
        "form": "도",
        "romanization": "do",
        "meaning_en": "also / too",
        "part_of_speech": "particle",
        "requires_host": true,
        "example_ko": "물도 주세요.",
        "example_en": "Please give me water, too."
      }
    ],
    "teaching_note": {
      "en": "더 (more) and 도 (also/too) are not the same kind of word. 더 is an adverb that can stand in front of a verb on its own. 도 is a particle that always attaches directly to a noun, with no space — it never appears alone.",
      "ko": "더는 부사라서 동사 앞에 혼자 올 수 있어요. 도는 조사라서 명사에 붙여 써요 — 혼자서는 쓰이지 않아요."
    },
    "prompt": {
      "type": "meaning_to_word",
      "text_en": "Which word means \"also/too\"?",
      "choices": [
        "더",
        "도"
      ],
      "answer": "도"
    },
    "verification": {
      "status": "externally_verified",
      "scope": "Meaning and grammatical behavior supplied as new curriculum content; not confirmed from the existing curriculum.json arrays.",
      "notes": "더 (more) verified as a basic adverb usable standalone before a verb (e.g. 더 주세요). 도 (also/too) verified as a case-marking-position particle that attaches directly to a noun with no space and cannot occur as a free-standing word — this is why the pair is classified lexical_vs_grammar_form rather than lexical_minimal_pair, and why both items are marked requires_host: true. Decodable from lesson 2 onward (ㄷ+ㅓ and ㄷ+ㅗ), earlier than either existing seed pair."
    }
  },
